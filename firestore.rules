rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // केवल ये admin UID(s) ही job/news docs लिख/बदल/मिटा सकें।
    // Admin SDK (bots) इन rules को bypass करता है — bot pipeline अप्रभावित।
    function isAdmin() {
      return request.auth != null
          && request.auth.uid in [
            "tgHjEVv2FwWygy9x0rxe5k4ZzOt1"
          ];
    }

    // ── SSC JOBS ──────────────────────────────────────────────────────────
    match /ssc_jobs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── RSMSSB JOBS ───────────────────────────────────────────────────────
    match /rsmssb_jobs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── RSSB JOBS ─────────────────────────────────────────────────────────
    match /rssb_jobs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── SCHOLARSHIP NOTICES ───────────────────────────────────────────────
    match /scholarship_notices/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
